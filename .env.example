# Template only — copy to `.env` and fill in real values there.
# `.env` is gitignored; never put a real password, DB URL, or mailbox in this
# file. Every value below is a placeholder.
#
# ─── Zoho Mail senders (SMTP send + IMAP reply polling) ──────────────
# Region hosts: India accounts use .in, global use .com. Match your Zoho region.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_IMAP_HOST=imap.zoho.in
ZOHO_IMAP_PORT=993

# Sender 1
SENDER_EMAIL_1=first.sender@your-domain.com
SENDER_NAME_1=First Sender
SENDER_TITLE_1=Founder, Your Company
BOOKING_LINK_1=
# Zoho app-specific password (Zoho → Settings → Security → App Passwords)
SMTP_PASS_1=
# Optional: login if different from the email (usually leave blank)
SMTP_USER_1=

# Sender 2
SENDER_EMAIL_2=second.sender@your-domain.com
SENDER_NAME_2=Second Sender
SENDER_TITLE_2=
BOOKING_LINK_2=
SMTP_PASS_2=
SMTP_USER_2=

# ─── Gmail senders (SMTP + IMAP) ─────────────────────────────────────
# Two ways to authenticate a Gmail / Google Workspace mailbox. A refresh token,
# when present, wins over SMTP_PASS_N.
#
# A) APP PASSWORD — needs 2-Step Verification on the account:
#   1. myaccount.google.com/security     → turn on 2-Step Verification
#   2. myaccount.google.com/apppasswords → create one, paste the 16 characters
#      with no spaces into SMTP_PASS_N
#
# B) OAUTH 2.0 — no 2FA required, more setup. One Cloud project serves every
#    Gmail mailbox; the refresh token is per mailbox.
#   1. console.cloud.google.com → project → enable the "Gmail API"
#   2. OAuth consent screen → External → add scope https://mail.google.com/
#      (IMAP needs the full scope; gmail.send alone cannot open IMAP)
#      → add each mailbox as a Test user
#   3. PUBLISH APP. Left in "Testing", Google expires refresh tokens every
#      7 days and the mailer breaks weekly.
#   4. Credentials → OAuth client ID → **Desktop app** (allows the loopback
#      redirect) → fill GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below
#   5. npx tsx scripts/google-oauth-setup.ts --sender N
#      → paste the GOOGLE_REFRESH_TOKEN_N line it prints
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN_6=
#
# Either way, enable IMAP in the mailbox (reply detection polls over IMAP):
#   Gmail → Settings → See all settings → Forwarding and POP/IMAP → Enable IMAP
#
# Hosts are inferred from an @gmail.com address, so no host vars are needed.
# For Google Workspace on a custom domain, set SENDER_PROVIDER_N=gmail.
# SENDER_EMAIL_6=someone@gmail.com
# SENDER_NAME_6=Someone
# SENDER_TITLE_6=
# BOOKING_LINK_6=
# SMTP_PASS_6=
# SENDER_PROVIDER_6=gmail

# Per-sender host overrides (rarely needed — only when a mailbox is on a
# provider with no preset). These beat the provider preset and the ZOHO_*
# globals above. Ports use implicit TLS: 465 SMTP, 993 IMAP.
# SMTP_HOST_6=
# SMTP_PORT_6=465
# IMAP_HOST_6=
# IMAP_PORT_6=993

# ─── Microsoft 365 / Outlook senders (Microsoft Graph) ───────────────
# A mailbox on a Microsoft 365 tenant (e.g. an @olum.ai Outlook mailbox) cannot
# use SMTP: Microsoft retired basic-auth SMTP. It sends through Graph instead,
# with an Azure app registration using the client-credentials flow.
#
# In Azure Portal → App registrations → your app:
#   • Overview            → copy "Application (client) ID" and "Directory (tenant) ID"
#   • Certificates & secrets → New client secret → copy the VALUE (not the ID);
#                           it is shown once, and it expires — note the date
#   • API permissions     → Add permission → Microsoft Graph → APPLICATION
#                           permissions → Mail.Send and Mail.Read →
#                           "Grant admin consent for <your tenant>"
#
# Application permissions reach EVERY mailbox in the tenant. Restrict each app
# to its own mailbox with an Exchange Application Access Policy:
#   New-ApplicationAccessPolicy -AppId <client id> -PolicyScopeGroupId <mailbox> `
#     -AccessRight RestrictAccess -Description "outreach mailer"
#
# Shared by every Graph sender (override per sender with GRAPH_TENANT_ID_N).
GRAPH_TENANT_ID=

# Example: make sender 5 an Outlook mailbox.
# SENDER_EMAIL_5=someone@your-m365-domain.com
# SENDER_NAME_5=Someone
# SENDER_TITLE_5=Founder, Your Company
# BOOKING_LINK_5=
# Each mailbox normally gets its OWN app registration (its own client id +
# secret). Reusing one app across mailboxes works, but then one expired secret
# takes every mailbox down at once.
# GRAPH_CLIENT_ID_5=
# GRAPH_CLIENT_SECRET_5=
# Optional. Transport is inferred — a sender with GRAPH_CLIENT_ID_N and no
# SMTP_PASS_N uses Graph. Set this only to force it either way.
# SENDER_TRANSPORT_5=graph

# Add more senders by adding SENDER_EMAIL_3, _4, … up to _12 (the app
# auto-detects any SENDER_EMAIL_N that's set — no code change needed).
# Remove a sender by clearing its SENDER_EMAIL_N.
SENDER_EMAIL_3=
SENDER_NAME_3=
SENDER_TITLE_3=
BOOKING_LINK_3=
SMTP_PASS_3=
SMTP_USER_3=

# ─── Company footer (CAN-SPAM legitimacy in every email) ─────────────
COMPANY_NAME=Your Company
COMPANY_ADDRESS=

# ─── Database (Neon / Vercel Postgres) ───────────────────────────────
DATABASE_URL=postgres://<USER>:<PASSWORD>@<HOST>/<DB>?sslmode=require

# Offline dev mode: run the app against an in-memory Postgres (PGlite) seeded
# from data/snapshot.json instead of Neon. Capture a snapshot first with
# `npx tsx scripts/snapshot.ts`, then set this true. Leave false/unset normally.
USE_LOCAL_SNAPSHOT=false

# ─── Notifications ───────────────────────────────────────────────────
# Who gets alerted on replies + meeting bookings.
NOTIFY_EMAIL=alerts@your-domain.com
# Which sender mailbox sends system notifications (1, 2, or 3).
NOTIFY_SENDER=1

# ─── Cron security ───────────────────────────────────────────────────
# Long random string. Send it as an `Authorization: Bearer <secret>` header —
# ?key=... still works but lands in access logs and browser history, so treat
# any secret you've used that way as burned and rotate it.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ─── Internal-tool access gate ───────────────────────────────────────
# Single shared password to open the dashboard. Minimum 16 chars — this is the
# only thing between the public internet and the whole prospect database.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_PASSWORD=

# ─── Sending window ──────────────────────────────────────────────────
# Set false to send 24/7, any day (jitter/delays still apply). true = restrict
# to the hours/days below.
BUSINESS_HOURS_ENABLED=false
# Fixed UTC offset — IST = 5.5, SG = 8, UAE = 4 (only used when enabled)
BUSINESS_TZ_OFFSET=5.5
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
# Days sending is allowed: 0=Sun,1=Mon,…,6=Sat. Default Mon–Sat (Saturday on,
# Sunday off). Use 1,2,3,4,5 for Mon–Fri, or 0,1,2,3,4,5,6 for every day.
BUSINESS_SEND_DAYS=1,2,3,4,5,6

# ─── Product-feedback campaigns (/campaigns/report) ──────────────────
# Which mailbox writes to our own signed-up users. The whole list goes out
# from this one mailbox.
REPORT_SENDER=2
# Named in the "grab 15 minutes with X, our founder" line.
FOUNDER_NAME=
# The meeting link offered in those emails is BOOKING_LINK_<REPORT_SENDER>
# (i.e. BOOKING_LINK_2 above). It can also be pasted per campaign in the form;
# with no link, the whole "book a call" paragraph is dropped.
#
# Users on these domains are our own staff and are never mailed as customers.
# The senders' own domains are always included automatically.
INTERNAL_DOMAINS=your-domain.com
# Substrings that mark a signup as one of our test accounts (they show a
# "team?" flag and start unticked). Defaults to the SENDER_NAME_N first names.
# TEAM_EMAIL_HINTS=

# ─── Meeting entry timezone (your team's TZ — IST = 5.5, no DST) ──────
# Meeting times you type in the UI are read as this offset; all times are
# also displayed in IST. This is separate from the SG sending window.
MEETING_TZ_OFFSET=5.5

# ─── Drip pacing (seconds) ───────────────────────────────────────────
DELAY_MIN_SEC=45
DELAY_MAX_SEC=120
PAUSE_EVERY_N=7
PAUSE_MIN_SEC=180
PAUSE_MAX_SEC=480
# Max emails sent per tick (both the local mailer and the Vercel cron).
MAX_SENDS_PER_TICK=4
# Local mailer loop interval in seconds.
MAILER_INTERVAL_SEC=20
# Set true LOCALLY to make `npm run dev` auto-send from your machine.
# Leave unset on Vercel (the cron drives sending there).
ENABLE_LOCAL_MAILER=false
# Every sent email is stored in the `sent_emails` DB table (durable on Vercel).

# ─── Activity outreach (/approvals) ──────────────────────────────────
# Pulls Olum users + what they did in the product from olum-backend, drafts a
# personalised email per user with NEW activity, and holds it for approval.
# Nothing is sent to a user until someone presses Approve on /approvals.
ACTIVITY_OUTREACH_ENABLED=false
# olum-backend users feed. Must match the backend's OUTREACH_FEED_KEY.
OLUM_FEED_URL=https://olum.ai/api/v1/auth/outreach/users
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OLUM_FEED_KEY=
# Mailbox the approved emails go out from (defaults to REPORT_SENDER).
ACTIVITY_SENDER=
# Who gets the "N drafts waiting for approval" email (defaults to NOTIFY_EMAIL).
APPROVER_EMAIL=
# This app's public URL — used for the review link in that email.
APP_URL=https://your-outreach-app.vercel.app
# Linked from the "your site has been analysed" email.
OLUM_DASHBOARD_URL=https://olum.ai/app/overview
# How often the cron tick re-reads the feed.
ACTIVITY_SYNC_MINUTES=15
# At most one email per user in this many days (counts every campaign).
ACTIVITY_COOLDOWN_DAYS=14
# A user signed up within this many days and never emailed is "new": their
# first email is "your site has been analysed", once their analysis finishes.
ACTIVITY_NEW_USER_DAYS=14
# Don't draft while someone is mid-session (avoids "your analysis is stuck"
# for a run that is still going).
ACTIVITY_SETTLE_MINUTES=120
# First sync: false = only record where everyone is today (no drafts);
# true = draft for everyone's current activity straight away.
ACTIVITY_BACKFILL=false
